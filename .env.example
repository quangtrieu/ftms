# FTMS — biến môi trường (chép thành .env, điền giá trị RIÊNG, chmod 600)
DB_PASSWORD=
JWT_SECRET=
INITIAL_PASSWORD=          # mật khẩu ban đầu cho 44 tài khoản — phát trong ngày
SITE_ADDRESS=viec.congty.vn   # hoặc 150.95.108.206 (Caddy tự cấp chứng chỉ nội bộ)
COOKIE_SECURE=1
ALLOW_DEV_HEADER=0
SYSTEM_TODAY=              # CHỈ đặt khi chạy kiểm thử (2026-09-04)
ANTHROPIC_API_KEY=         # điền khi bật trợ lý gọi Claude thật
SMTP_URL=                  # smtps://user:app-password@smtp.gmail.com:465
SMTP_FROM=
